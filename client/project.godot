; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Civilization"
run/main_scene="res://pages/login/login.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[autoload]

ScreenProfile="*res://autoload/screen_profile.gd"
WindowSizer="*res://autoload/window_sizer.gd"
GameStore="*res://autoload/game_store.gd"
CardDB="*res://autoload/card_db.gd"
Net="*res://autoload/ws_client.gd"
Sfx="*res://autoload/sfx.gd"
Platform="*res://autoload/platform.gd"
LocalServer="*res://autoload/local_server.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

; 引擎默认即为 true；显式固定，避免导入改回串行。PNG 走 ResourceImporterTexture，支持线程池导入。
import/use_multiple_threads=true

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular-subset.ttf"

[internationalization]

locale/translations=PackedStringArray("res://text/zh_CN.zh_CN.translation")
locale/fallback="zh_CN"

[network]

allow_insecure_tls=false

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 2
}

[rendering]

; 桌面走 Forward+（macOS 为 Metal）：GLES3 桌面后端不提供 BPTC，BC7 纹理会被回退成 RGBA8。
; 移动端保持 gl_compatibility，ASTC 在该后端可用。
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
