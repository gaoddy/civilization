{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization.local/protocol/v1/view.schema.json",
  "title": "玩家可见状态视图 v1",
  "$defs": {
    "TargetZone": {
      "type": "string",
      "enum": ["hand", "shop", "board"],
      "description": "目标所在区域：本人手牌、本人商店、我方棋盘"
    },
    "TargetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "id"],
      "properties": {
        "zone": { "$ref": "view.schema.json#/$defs/TargetZone" },
        "id": { "type": "string", "description": "目标实例编号；三个区域共用同一编号空间" }
      }
    },
    "Phase": {
      "type": "string",
      "enum": ["Lobby", "Recruit", "Combat", "Settle", "GameOver"],
      "description": "对局阶段"
    },
    "ShopSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "instanceId", "cardId", "frozen"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "instanceId": { "type": ["string", "null"], "description": "卡牌实例编号；空槽位为 null" },
        "cardId": { "type": ["string", "null"], "description": "空槽位为 null" },
        "frozen": { "type": "boolean" }
      }
    },
    "HandCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "instanceId", "cardId", "golden", "attack", "health", "rewardLevel", "playable", "requiresTarget", "targetCandidates", "disabledReason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 9 },
        "instanceId": { "type": "string", "description": "卡牌实例编号；买入、上手与三连合成沿用同一编号" },
        "cardId": { "type": "string" },
        "golden": { "type": "boolean", "description": "随从牌为金色三连结果；效果牌恒为 false" },
        "attack": { "type": ["integer", "null"], "description": "随从牌的当前攻击力（已含成长等全部层数，学者为 0）；效果牌为 null" },
        "health": { "type": ["integer", "null"], "description": "随从牌的当前生命值；效果牌为 null" },
        "rewardLevel": { "type": ["integer", "null"], "minimum": 1, "maximum": 6, "description": "「三连奖励」锁定的发现星级；其它牌为 null" },
        "playable": { "type": "boolean", "description": "服务端算好的可打出提示" },
        "requiresTarget": { "type": "boolean", "description": "该牌是否需要玩家指定单一目标" },
        "targetCandidates": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/TargetRef" }, "description": "该牌的合法目标；随从牌为空数组" },
        "disabledReason": { "type": ["string", "null"], "description": "不可操作时的错误码" }
      }
    },
    "BoardMinion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "minionId", "cardId", "golden", "attack", "health", "keywords", "stealth", "sellable"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "该随从在当前存活随从序列中的下标；上界由 PlayerView.boardSlots 决定" },
        "minionId": { "type": "string", "description": "随从实例 id" },
        "cardId": { "type": "string" },
        "golden": { "type": "boolean" },
        "attack": { "type": "integer", "minimum": 0 },
        "health": { "type": "integer", "minimum": 0 },
        "keywords": { "type": "array", "items": { "type": "string" }, "description": "当前生效的关键词，取值为英文 id" },
        "stealth": { "type": "boolean", "description": "当前是否仍处于潜行：携带 stealth 关键词且尚未被打破" },
        "sellable": { "type": "boolean" },
        "stats": { "$ref": "view.schema.json#/$defs/MinionStats", "description": "攻防分层构成；旧客户端可忽略" }
      }
    },
    "MinionStatBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "permanent", "turn", "aura", "damage", "current"],
      "description": "单项属性的分层构成；在可达的下发状态下 initial + permanent + turn + aura - damage = current",
      "properties": {
        "initial": { "type": "integer", "minimum": 0, "description": "基础值" },
        "permanent": { "type": "integer", "description": "成长与永久增量之和" },
        "turn": { "type": "integer", "description": "本回合临时增量，可为负" },
        "aura": { "type": "integer", "description": "光环派生增量，可为负" },
        "damage": { "type": "integer", "minimum": 0, "description": "层和与当前值之差" },
        "current": { "type": "integer", "minimum": 0, "description": "当前实际值" }
      }
    },
    "MinionStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "health"],
      "description": "随从攻击与生命的分层构成",
      "properties": {
        "attack": { "$ref": "view.schema.json#/$defs/MinionStatBreakdown" },
        "health": { "$ref": "view.schema.json#/$defs/MinionStatBreakdown" }
      }
    },
    "CombatLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "participantIds", "ghostId", "winnerId", "loserId", "damage", "mirror"],
      "properties": {
        "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
        "participantIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string" },
          "description": "参战玩家 id；幽灵战只有对战方一个元素（幽灵不是玩家）"
        },
        "ghostId": { "type": ["string", "null"], "description": "幽灵战为幽灵归属者的玩家 id；真实战为 null" },
        "winnerId": { "type": ["string", "null"], "description": "平局无胜者时为 null" },
        "loserId": { "type": ["string", "null"], "description": "幽灵战失利时为该玩家；幽灵不受伤，所以幽灵输时也为 null" },
        "damage": { "type": "integer", "minimum": 0 },
        "mirror": { "type": "boolean", "description": "true 表示对战已出局者的幽灵阵容" }
      }
    },
    "PlayerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "seat", "displayName", "hp", "era", "alive", "boardCount", "heroCardId", "recruited", "managed", "rank"],
      "properties": {
        "playerId": { "type": "string" },
        "seat": { "type": "integer", "minimum": 0, "maximum": 7 },
        "displayName": { "type": "string" },
        "hp": { "type": "integer" },
        "era": { "type": "integer", "minimum": 1, "maximum": 7 },
        "rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 8, "description": "当前名次；对局结束前为实时名次，结束后等于 placement" },
        "alive": { "type": "boolean" },
        "boardCount": { "type": "integer", "minimum": 0, "maximum": 7 },
        "heroCardId": { "type": ["string", "null"], "description": "开局选择前为 null" },
        "recruited": { "type": "boolean", "description": "本回合是否已结束招募" },
        "placement": { "type": ["integer", "null"], "description": "最终名次，对局结束前为 null" },
        "managed": { "type": "boolean", "description": "当前是否由 AI 托管" }
      }
    },
    "ShopAffordance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "buyable", "disabledReason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 5 },
        "buyable": { "type": "boolean" },
        "disabledReason": { "type": ["string", "null"] }
      }
    },
    "HandAffordance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "playable", "disabledReason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 9 },
        "playable": { "type": "boolean" },
        "disabledReason": { "type": ["string", "null"] }
      }
    },
    "BoardAffordance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "sellable", "disabledReason"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 6 },
        "sellable": { "type": "boolean" },
        "disabledReason": { "type": ["string", "null"] }
      }
    },
    "Affordances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shopSlots", "handCards", "boardMinions", "canReroll", "canUpgradeEra",
                   "upgradeDisabledReason", "canEndRecruit"],
      "properties": {
        "shopSlots": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/ShopAffordance" } },
        "handCards": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/HandAffordance" } },
        "boardMinions": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardAffordance" } },
        "canReroll": { "type": "boolean" },
        "canUpgradeEra": { "type": "boolean" },
        "upgradeDisabledReason": { "type": ["string", "null"] },
        "canEndRecruit": { "type": "boolean" }
      }
    },
    "HeroPower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "usesLeft", "requiresTarget", "targetCandidates", "canUse", "disabledReason"],
      "properties": {
        "skillId": { "type": "string" },
        "usesLeft": { "type": "integer", "minimum": 0 },
        "requiresTarget": { "type": "boolean", "description": "该主动技能是否需要玩家指定单一目标" },
        "targetCandidates": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/TargetRef" }, "description": "该主动技能的合法目标" },
        "canUse": { "type": "boolean" },
        "disabledReason": { "type": ["string", "null"], "description": "不可使用该技能时的错误码" }
      }
    },
    "GameEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["MinionBought", "MinionSold", "ShopRolled", "EraUpgraded",
                   "TripleFormed", "CardDiscovered", "DamageTaken", "PlayerEliminated",
                   "TurnStarted", "PhaseChanged", "GameOver"]
        },
        "playerId": { "type": "string", "description": "事件涉及的玩家，可省略表示自己" },
        "seat": { "type": "integer", "minimum": 0, "maximum": 7, "description": "事件涉及的座位；客户端可经 PlayerView.players 映射到 playerId" },
        "cardId": { "type": "string" },
        "minionId": { "type": "string" },
        "amount": { "type": "integer", "description": "伤害等数值" },
        "place": { "type": ["integer", "null"], "minimum": 1, "maximum": 8, "description": "PlayerEliminated 事件对该座位判定的名次；其他事件为 null" },
        "turn": { "type": "integer", "minimum": 1, "maximum": 20, "description": "TurnStarted/PhaseChanged 事件对应的回合号" },
        "phase": { "$ref": "view.schema.json#/$defs/Phase", "description": "PhaseChanged 事件进入的阶段" },
        "ranking": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 7 },
          "description": "GameOver 事件的座位排名，从第 1 名起"
        }
      }
    },
    "PendingChoice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "candidates"],
          "properties": {
            "kind": { "const": "discover", "description": "固定为 discover" },
            "candidates": { "type": "array", "items": { "type": "string" }, "description": "三选一的候选 cardId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "evolve", "description": "固定为 evolve" },
            "options": { "type": "array", "items": { "type": "string" }, "description": "进化选项，取值为英文 id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceMinionId", "candidates"],
          "properties": {
            "kind": { "const": "target", "description": "固定为 target" },
            "sourceMinionId": { "type": "string", "description": "触发该待选的随从" },
            "candidates": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/TargetRef" }, "description": "战吼待选的合法目标" }
          }
        }
      ]
    },
    "PlayerView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "phase", "turn", "phaseDeadline", "boardSlots", "self", "players", "enabledFactions", "hpCap", "combatLog"],
      "properties": {
        "roomId": { "type": "string" },
        "phase": { "$ref": "view.schema.json#/$defs/Phase" },
        "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
        "phaseDeadline": { "type": "string", "format": "date-time" },
        "boardSlots": { "type": "integer", "minimum": 1, "description": "本方棋盘随从位上限，v0.1 为 7" },
        "hpCap": { "type": "integer", "minimum": 1, "description": "生命上限，v0.1 为 40" },
        "combatLog": {
          "type": "array",
          "description": "本局最近 5 个回合的全部战斗，按回合升序；全对局公开",
          "items": { "$ref": "view.schema.json#/$defs/CombatLogEntry" }
        },
        "opponentPlayerId": { "type": ["string", "null"], "description": "当前战斗对手；招募阶段或未配对时为 null" },
        "self": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerId", "seat", "hp", "era", "gold", "heroCardId", "heroPowers",
                       "shop", "hand", "board", "rerollCost", "upgradeCost", "recruited", "pendingChoices", "affordances"],
          "properties": {
            "playerId": { "type": "string" },
            "seat": { "type": "integer", "minimum": 0, "maximum": 7 },
            "hp": { "type": "integer" },
            "era": { "type": "integer", "minimum": 1, "maximum": 7 },
            "gold": { "type": "integer", "minimum": 0 },
            "heroCardId": { "type": ["string", "null"] },
            "heroPowers": {
              "type": "array",
              "items": { "$ref": "view.schema.json#/$defs/HeroPower" },
              "description": "英雄卡上的全部主动技能，按英雄卡 skills 顺序排列；没有主动技能时为空"
            },
            "shop": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/ShopSlot" } },
            "hand": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/HandCard" } },
            "board": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardMinion" } },
            "rerollCost": { "type": "integer", "minimum": 0 },
            "upgradeCost": { "type": ["integer", "null"], "minimum": 2, "description": "满时代为 null" },
            "recruited": { "type": "boolean" },
            "pendingChoices": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/PendingChoice" }, "description": "本座位待处理的发现或进化选择，按先到先处理排序" },
            "affordances": { "$ref": "view.schema.json#/$defs/Affordances" }
          }
        },
        "players": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/PlayerSummary" } },
        "enabledFactions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5,
          "description": "本局启用的 5 个玩法"
        }
      }
    }
  }
}
