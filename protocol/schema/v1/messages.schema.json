{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization.local/protocol/v1/messages.schema.json",
  "title": "协议消息载荷 v1",
  "$defs": {
    "AuthRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phone", "code"],
          "properties": {
            "phone": { "type": "string", "description": "手机号" },
            "code": { "type": "string", "description": "短信验证码" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 20, "description": "缺省由服务端生成「玩家N」" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["token"],
          "properties": {
            "token": { "type": "string", "description": "上次登录返回的令牌" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 20, "description": "缺省由服务端生成「玩家N」" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["steamTicket"],
          "properties": {
            "steamTicket": { "type": "string", "minLength": 1, "maxLength": 2048, "description": "Steam Web API 票据十六进制串" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Steam 个人资料名；仅作展示，服务端截断为 20 字符" }
          }
        }
      ]
    },
    "CreateRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "JoinRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "description": "6 位房间码" }
      }
    },
    "LeaveRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "JoinQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "LeaveQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "RequestLeaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "RequestProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "playerId": { "type": "string", "description": "要查看的玩家；缺省为本人" }
      }
    },
    "KickMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetPlayerId"],
      "properties": {
        "targetPlayerId": { "type": "string", "description": "要被移出房间的玩家 playerId" }
      }
    },
    "DissolveRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "Ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": {
        "ready": { "type": "boolean" }
      }
    },
    "StartGame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "SetBotFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean", "description": "是否在开始时用机器人补满空位" }
      }
    },
    "SelectHeroCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId"],
      "properties": {
        "cardId": { "type": "string" }
      }
    },
    "IntentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientIntentId", "intent"],
      "properties": {
        "clientIntentId": { "type": "string", "minLength": 1, "description": "客户端生成，用于幂等" },
        "intent": { "$ref": "intents.schema.json#/$defs/Intent" }
      }
    },
    "RequestSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "CombatPlayed": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "Reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "lastSeq"],
      "properties": {
        "roomId": { "type": "string" },
        "lastSeq": { "type": "integer", "minimum": 0, "description": "客户端最后收到的 seq" }
      }
    },
    "FriendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toPlayerCode"],
      "properties": {
        "toPlayerCode": { "type": "string", "description": "6 位玩家编号" }
      }
    },
    "FriendRespond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromPlayerId", "accept"],
      "properties": {
        "fromPlayerId": { "type": "string", "description": "申请人的 playerId" },
        "accept": { "type": "boolean" }
      }
    },
    "FriendRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendId"],
      "properties": {
        "friendId": { "type": "string" }
      }
    },
    "InviteToRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendId"],
      "properties": {
        "friendId": { "type": "string" }
      }
    },
    "RespondInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "accept"],
      "properties": {
        "inviteId": { "type": "string" },
        "accept": { "type": "boolean" }
      }
    },
    "AuthResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "playerCode", "token", "expiresAt"],
      "properties": {
        "playerId": { "type": "string", "description": "内部不透明标识，不向玩家展示" },
        "playerCode": { "type": "string", "description": "6 位玩家编号，用于好友搜索与展示" },
        "token": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "RoomUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "code", "hostId", "phase", "botFill", "players"],
      "properties": {
        "roomId": { "type": "string" },
        "code": { "type": "string", "description": "6 位房间码" },
        "hostId": { "type": "string" },
        "phase": { "$ref": "view.schema.json#/$defs/Phase" },
        "botFill": { "type": "boolean", "description": "开始时空位是否用机器人补满" },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "displayName", "ready", "isHost", "seat"],
            "properties": {
              "playerId": { "type": "string" },
              "displayName": { "type": "string" },
              "ready": { "type": "boolean" },
              "isHost": { "type": "boolean" },
              "seat": { "type": "integer", "minimum": 0, "maximum": 7 }
            }
          }
        }
      }
    },
    "RoomClosed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["kicked", "dissolved"],
          "description": "kicked：被房主移出；dissolved：房间已解散"
        }
      }
    },
    "QueueState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waitingMs", "waitingPlayers", "ratingWindow"],
      "properties": {
        "waitingMs": { "type": "integer", "minimum": 0, "description": "本人已等待时长（毫秒）" },
        "waitingPlayers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "当前队列里的玩家数，客户端显示为「已凑 X/8」"
        },
        "ratingWindow": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "当前匹配积分半径；null 表示不限积分"
        }
      }
    },
    "MatchFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "seat"],
      "properties": {
        "roomId": { "type": "string" },
        "seat": { "type": "integer", "minimum": 0, "maximum": 7, "description": "服务端分配的座位号（0 起）" }
      }
    },
    "HeroPickStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline", "candidates", "players"],
      "properties": {
        "deadline": { "type": "string", "description": "选英雄截止时刻（RFC3339）" },
        "candidates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "收件人本座位可选的英雄卡 id；该消息按座位逐条下发"
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seat", "displayName", "isBot", "picked"],
            "properties": {
              "seat": { "type": "integer", "minimum": 0, "maximum": 7 },
              "displayName": { "type": "string" },
              "isBot": { "type": "boolean" },
              "picked": { "type": "boolean", "description": "该座位是否已确认英雄" }
            }
          }
        }
      }
    },
    "GameStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "快照对应的座位消息序号；与信封 seq 一致，M1 新增可选字段"
        }
      }
    },
    "StateUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "events"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" },
        "events": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/GameEvent" } }
      }
    },
    "PhaseChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "turn", "deadline"],
      "properties": {
        "phase": { "$ref": "view.schema.json#/$defs/Phase" },
        "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "TimerWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondsLeft"],
      "properties": {
        "secondsLeft": { "type": "integer", "minimum": 0 }
      }
    },
    "CombatMinionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minionId", "attack", "health", "alive"],
      "properties": {
        "minionId": { "type": "string", "description": "随从实例 id" },
        "attack": { "type": "integer", "minimum": 0 },
        "health": { "type": "integer", "minimum": 0 },
        "alive": { "type": "boolean" }
      }
    },
    "CombatResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownBoard", "opponentBoard", "actions", "damage", "winnerId", "startedAt"],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "本场演示开始时刻（服务端时钟，RFC3339）；重连补发时保持同值"
        },
        "ownBoard": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardMinion" } },
        "opponentBoard": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardMinion" } },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "description": "动作类型，具体取值由规则引擎实现确定" },
              "cardId": {
                "type": ["string", "null"],
                "description": "动作直接涉及的卡牌 id（如零件回收获得的牌）；没有卡牌载荷的动作省略"
              },
              "sourceIndex": { "type": ["integer", "null"] },
              "targetIndex": { "type": ["integer", "null"] },
              "damage": { "type": ["integer", "null"] },
              "sourceSide": {
                "type": ["string", "null"],
                "enum": ["own", "opponent", null],
                "description": "sourceIndex 所指棋盘，相对接收该消息的座位；null 表示本条动作没有来源下标"
              },
              "targetSide": {
                "type": ["string", "null"],
                "enum": ["own", "opponent", null],
                "description": "targetIndex 所指棋盘，相对接收该消息的座位；null 表示本条动作没有目标下标"
              },
              "sourceMinionId": {
                "type": ["string", "null"],
                "description": "动作来源随从实例 id；死亡、复生、召唤等无来源动作为 null"
              },
              "targetMinionId": {
                "type": ["string", "null"],
                "description": "动作目标随从实例 id；死亡、复生、召唤等无目标动作为 null"
              },
              "source": { "$ref": "#/$defs/CombatMinionState" },
              "target": { "$ref": "#/$defs/CombatMinionState" },
              "summon": {
                "type": "object",
                "additionalProperties": false,
                "required": ["side", "position", "minion"],
                "properties": {
                  "side": { "type": "string", "enum": ["own", "opponent"], "description": "相对接收该消息的座位" },
                  "position": { "type": "integer", "minimum": 0, "description": "召唤后该随从在存活随从序列中的插入下标；上界由 PlayerView.boardSlots 决定" },
                  "minion": { "$ref": "view.schema.json#/$defs/BoardMinion" }
                }
              }
            }
          }
        },
        "damage": { "type": "integer", "minimum": 0, "description": "本场战斗结算给败者的伤害（含幽灵战）；平局与幽灵战落单座位获胜时为 0" },
        "winnerId": { "type": ["string", "null"], "description": "本场胜者；玩家自己的 playerId 表示胜" },
        "mirror": {
          "type": "boolean",
          "description": "true 表示本场为幽灵战，对手是已出局者的幽灵阵容"
        }
      }
    },
    "GameOver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking", "seed", "ratingDelta", "ratingAfter", "tierBefore", "tierAfter"],
      "properties": {
        "ratingDelta": {
          "type": ["integer", "null"],
          "description": "本局实际入账积分变化；房间局为 null"
        },
        "ratingAfter": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "结算后个人总分；房间局为 null"
        },
        "tierBefore": {
          "type": ["string", "null"],
          "description": "结算前段位 id；房间局为 null"
        },
        "tierAfter": {
          "type": ["string", "null"],
          "description": "结算后段位 id；房间局为 null"
        },
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "place"],
            "properties": {
              "playerId": { "type": "string" },
              "place": { "type": "integer", "minimum": 1, "maximum": 8 },
              "survivedTurns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "description": "该座位存活到的回合；旧客户端缺省按 0 处理"
              },
              "damageDealt": {
                "type": "integer",
                "minimum": 0,
                "description": "该座位本局造成的总伤害；旧客户端缺省按 0 处理"
              }
            }
          }
        },
        "seed": { "type": "string", "description": "会战模式对局结束后公开的种子" },
        "selfStats": {
          "$ref": "#/$defs/SelfStats",
          "description": "接收者本人的本局统计；只填接收者所在座位"
        }
      }
    },
    "SelfStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "survivedTurns",
        "finalHp",
        "finalEra",
        "remainingGold",
        "damageDealt",
        "damageTaken",
        "buys",
        "sells",
        "rerolls",
        "triples",
        "combatWins",
        "combatDraws",
        "combatLosses",
        "heroPowerUses",
        "board"
      ],
      "properties": {
        "place": { "type": "integer", "minimum": 1, "maximum": 8 },
        "survivedTurns": { "type": "integer", "minimum": 0, "maximum": 20 },
        "finalHp": { "type": "integer", "minimum": 0 },
        "finalEra": { "type": "integer", "minimum": 1, "maximum": 7 },
        "remainingGold": { "type": "integer", "minimum": 0 },
        "damageDealt": { "type": "integer", "minimum": 0 },
        "damageTaken": { "type": "integer", "minimum": 0 },
        "buys": { "type": "integer", "minimum": 0 },
        "sells": { "type": "integer", "minimum": 0 },
        "rerolls": { "type": "integer", "minimum": 0 },
        "triples": { "type": "integer", "minimum": 0 },
        "combatWins": { "type": "integer", "minimum": 0 },
        "combatDraws": { "type": "integer", "minimum": 0 },
        "combatLosses": { "type": "integer", "minimum": 0 },
        "heroPowerUses": { "type": "integer", "minimum": 0 },
        "board": {
          "type": "array",
          "maxItems": 7,
          "description": "终局棋盘，按站位顺序；最多 7 项",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cardId", "golden", "attack", "health"],
            "properties": {
              "cardId": { "type": "string" },
              "golden": { "type": "boolean" },
              "attack": { "type": "integer", "minimum": 0 },
              "health": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "Error": { "$ref": "errors.schema.json#/$defs/ErrorMessage" },
    "FriendUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friends", "incoming", "outgoing", "recent"],
      "properties": {
        "friends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "status"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string", "description": "6 位玩家编号" },
              "displayName": { "type": "string" },
              "status": { "type": "string", "enum": ["online", "inGame", "offline"] }
            }
          }
        },
        "incoming": {
          "type": "array",
          "items": { "$ref": "#/$defs/FriendRequestItem" }
        },
        "outgoing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "sentAt"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string" },
              "displayName": { "type": "string" },
              "sentAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "relation"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string" },
              "displayName": { "type": "string" },
              "relation": { "type": "string", "enum": ["none", "friend", "incoming", "outgoing"] }
            }
          }
        }
      }
    },
    "FriendRequestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "playerCode", "displayName", "sentAt"],
      "properties": {
        "playerId": { "type": "string" },
        "playerCode": { "type": "string" },
        "displayName": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    },
    "FriendInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "fromPlayerId", "fromPlayerCode", "fromDisplayName", "roomCode", "expiresAt"],
      "properties": {
        "inviteId": { "type": "string" },
        "fromPlayerId": { "type": "string" },
        "fromPlayerCode": { "type": "string" },
        "fromDisplayName": { "type": "string" },
        "roomCode": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "FriendInviteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "accepted"],
      "properties": {
        "inviteId": { "type": "string" },
        "accepted": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "description": "拒绝或失败原因的错误码" }
      }
    },
    "InviteAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "roomCode"],
      "properties": {
        "inviteId": { "type": "string" },
        "roomCode": { "type": "string" }
      }
    },
    "RequestAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "RequestPhoneCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone"],
      "properties": {
        "phone": { "type": "string", "description": "待绑定的手机号" }
      }
    },
    "BindPhone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phone", "code"],
      "properties": {
        "phone": { "type": "string", "description": "待绑定的手机号" },
        "code": { "type": "string", "description": "短信验证码" }
      }
    },
    "CreateRoomInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "RedeemRoomInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token"],
      "properties": {
        "token": { "type": "string", "description": "一次性邀请 token" }
      }
    },
    "AccountView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId", "playerCode", "displayName", "steamBound", "phoneBound",
        "rating", "tier", "highestTier"
      ],
      "properties": {
        "playerId": { "type": "string", "description": "内部不透明标识，不向玩家展示" },
        "playerCode": { "type": "string", "description": "6 位玩家编号" },
        "displayName": { "type": "string" },
        "steamBound": { "type": "boolean", "description": "账号是否绑定 Steam 身份" },
        "phoneBound": { "type": "boolean", "description": "账号是否绑定手机号" },
        "maskedPhone": { "type": ["string", "null"], "description": "前 3 位与后 4 位保留，其余用 *；未绑定为 null" },
        "rating": { "type": "integer", "minimum": 0, "description": "当前天梯积分；未结算过为 1000" },
        "tier": { "type": "string", "description": "当前段位 id" },
        "highestTier": { "type": "string", "description": "历史最高段位 id，按最高积分与当前配置计算" }
      }
    },
    "PhoneCodeSent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expiresAt"],
      "properties": {
        "expiresAt": { "type": "string", "format": "date-time", "description": "验证码失效时刻" }
      }
    },
    "RoomInviteCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "roomCode", "expiresAt"],
      "properties": {
        "token": { "type": "string", "description": "一次性邀请 token" },
        "roomCode": { "type": "string", "description": "6 位房间码" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "token 失效时刻，创建后 60 秒" }
      }
    },
    "AchievementState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unlocked"],
      "properties": {
        "unlocked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["achievementId", "steamApiName"],
            "properties": {
              "achievementId": { "type": "string" },
              "steamApiName": { "type": "string" }
            }
          }
        }
      }
    },
    "AchievementUnlocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["achievementId", "steamApiName"],
      "properties": {
        "achievementId": { "type": "string" },
        "steamApiName": { "type": "string" }
      }
    },
    "Leaderboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "playerId", "displayName", "tier", "rating"],
            "properties": {
              "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
              "playerId": { "type": "string", "description": "内部不透明标识，用于跳转个人主页" },
              "displayName": { "type": "string" },
              "tier": { "type": "string", "description": "段位 id" },
              "rating": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "PlayerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerId", "displayName", "rating", "tier", "highestTier",
        "recentVisible", "top4Ratio", "recent"
      ],
      "properties": {
        "playerId": { "type": "string", "description": "内部不透明标识，不向玩家展示" },
        "displayName": { "type": "string" },
        "rating": { "type": "integer", "minimum": 0 },
        "tier": { "type": "string", "description": "当前段位 id" },
        "highestTier": { "type": "string", "description": "历史最高段位 id" },
        "recentVisible": {
          "type": "boolean",
          "description": "最近 10 局是否对请求者可见；仅本人与好友为 true"
        },
        "top4Ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "最近 10 局中名次前 4 的比例；不可见或无记录时为 0"
        },
        "recent": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placement", "ratingDelta", "ratingAfter", "finishedAt"],
            "properties": {
              "placement": { "type": "integer", "minimum": 1, "maximum": 8 },
              "ratingDelta": { "type": "integer", "description": "实际入账积分变化" },
              "ratingAfter": { "type": "integer", "minimum": 0 },
              "finishedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
