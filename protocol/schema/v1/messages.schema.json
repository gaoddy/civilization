{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization.local/protocol/v1/messages.schema.json",
  "title": "协议消息载荷 v1",
  "$defs": {
    "AuthRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phone", "code"],
          "properties": {
            "phone": { "type": "string", "description": "手机号" },
            "code": { "type": "string", "description": "短信验证码" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 20, "description": "缺省由服务端生成「玩家N」" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["token"],
          "properties": {
            "token": { "type": "string", "description": "上次登录返回的令牌" },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 20, "description": "缺省由服务端生成「玩家N」" }
          }
        }
      ]
    },
    "CreateRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "JoinRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "description": "6 位房间码" }
      }
    },
    "LeaveRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "Ready": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready"],
      "properties": {
        "ready": { "type": "boolean" }
      }
    },
    "SelectHeroCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardId"],
      "properties": {
        "cardId": { "type": "string" }
      }
    },
    "IntentMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientIntentId", "intent"],
      "properties": {
        "clientIntentId": { "type": "string", "minLength": 1, "description": "客户端生成，用于幂等" },
        "intent": { "$ref": "intents.schema.json#/$defs/Intent" }
      }
    },
    "RequestSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "CombatPlayed": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "Reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "lastSeq"],
      "properties": {
        "roomId": { "type": "string" },
        "lastSeq": { "type": "integer", "minimum": 0, "description": "客户端最后收到的 seq" }
      }
    },
    "FriendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toPlayerCode"],
      "properties": {
        "toPlayerCode": { "type": "string", "description": "6 位玩家编号" }
      }
    },
    "FriendRespond": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromPlayerId", "accept"],
      "properties": {
        "fromPlayerId": { "type": "string", "description": "申请人的 playerId" },
        "accept": { "type": "boolean" }
      }
    },
    "FriendRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendId"],
      "properties": {
        "friendId": { "type": "string" }
      }
    },
    "InviteToRoom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friendId"],
      "properties": {
        "friendId": { "type": "string" }
      }
    },
    "RespondInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "accept"],
      "properties": {
        "inviteId": { "type": "string" },
        "accept": { "type": "boolean" }
      }
    },
    "AuthResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "playerCode", "token", "expiresAt"],
      "properties": {
        "playerId": { "type": "string", "description": "内部不透明标识，不向玩家展示" },
        "playerCode": { "type": "string", "description": "6 位玩家编号，用于好友搜索与展示" },
        "token": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "RoomUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "code", "hostId", "phase", "players"],
      "properties": {
        "roomId": { "type": "string" },
        "code": { "type": "string", "description": "6 位房间码" },
        "hostId": { "type": "string" },
        "phase": { "$ref": "view.schema.json#/$defs/Phase" },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "displayName", "ready", "isHost", "heroCardId"],
            "properties": {
              "playerId": { "type": "string" },
              "displayName": { "type": "string" },
              "ready": { "type": "boolean" },
              "isHost": { "type": "boolean" },
              "heroCardId": { "type": ["string", "null"] },
              "heroCandidates": {
                "type": ["array", "null"],
                "items": { "type": "string" },
                "description": "本座位可选的英雄卡 id；只在发给本人的 RoomUpdate 中下发"
              }
            }
          }
        }
      }
    },
    "GameStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" }
      }
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "description": "快照对应的座位消息序号；与信封 seq 一致，M1 新增可选字段"
        }
      }
    },
    "StateUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "events"],
      "properties": {
        "view": { "$ref": "view.schema.json#/$defs/PlayerView" },
        "events": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/GameEvent" } }
      }
    },
    "PhaseChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "turn", "deadline"],
      "properties": {
        "phase": { "$ref": "view.schema.json#/$defs/Phase" },
        "turn": { "type": "integer", "minimum": 1, "maximum": 20 },
        "deadline": { "type": "string", "format": "date-time" }
      }
    },
    "TimerWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secondsLeft"],
      "properties": {
        "secondsLeft": { "type": "integer", "minimum": 0 }
      }
    },
    "CombatMinionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minionId", "attack", "health", "alive"],
      "properties": {
        "minionId": { "type": "string", "description": "随从实例 id" },
        "attack": { "type": "integer", "minimum": 0 },
        "health": { "type": "integer", "minimum": 0 },
        "alive": { "type": "boolean" }
      }
    },
    "CombatResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownBoard", "opponentBoard", "actions", "damage", "winnerId", "startedAt"],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "本场演示开始时刻（服务端时钟，RFC3339）；重连补发时保持同值"
        },
        "ownBoard": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardMinion" } },
        "opponentBoard": { "type": "array", "items": { "$ref": "view.schema.json#/$defs/BoardMinion" } },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "description": "动作类型，具体取值由规则引擎实现确定" },
              "cardId": {
                "type": ["string", "null"],
                "description": "动作直接涉及的卡牌 id（如零件回收获得的牌）；没有卡牌载荷的动作省略"
              },
              "sourceIndex": { "type": ["integer", "null"] },
              "targetIndex": { "type": ["integer", "null"] },
              "damage": { "type": ["integer", "null"] },
              "sourceSide": {
                "type": ["string", "null"],
                "enum": ["own", "opponent", null],
                "description": "sourceIndex 所指棋盘，相对接收该消息的座位；null 表示本条动作没有来源下标"
              },
              "targetSide": {
                "type": ["string", "null"],
                "enum": ["own", "opponent", null],
                "description": "targetIndex 所指棋盘，相对接收该消息的座位；null 表示本条动作没有目标下标"
              },
              "sourceMinionId": {
                "type": ["string", "null"],
                "description": "动作来源随从实例 id；死亡、复生、召唤等无来源动作为 null"
              },
              "targetMinionId": {
                "type": ["string", "null"],
                "description": "动作目标随从实例 id；死亡、复生、召唤等无目标动作为 null"
              },
              "source": { "$ref": "#/$defs/CombatMinionState" },
              "target": { "$ref": "#/$defs/CombatMinionState" },
              "summon": {
                "type": "object",
                "additionalProperties": false,
                "required": ["side", "position", "minion"],
                "properties": {
                  "side": { "type": "string", "enum": ["own", "opponent"], "description": "相对接收该消息的座位" },
                  "position": { "type": "integer", "minimum": 0, "description": "召唤后该随从在存活随从序列中的插入下标；上界由 PlayerView.boardSlots 决定" },
                  "minion": { "$ref": "view.schema.json#/$defs/BoardMinion" }
                }
              }
            }
          }
        },
        "damage": { "type": "integer", "minimum": 0, "description": "本场战斗结算给败者的伤害（含幽灵战）；平局与幽灵战落单座位获胜时为 0" },
        "winnerId": { "type": ["string", "null"], "description": "本场胜者；玩家自己的 playerId 表示胜" },
        "mirror": {
          "type": "boolean",
          "description": "true 表示本场为幽灵战，对手是已出局者的幽灵阵容"
        }
      }
    },
    "GameOver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking", "seed"],
      "properties": {
        "ranking": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "place"],
            "properties": {
              "playerId": { "type": "string" },
              "place": { "type": "integer", "minimum": 1, "maximum": 8 }
            }
          }
        },
        "seed": { "type": "string", "description": "会战模式对局结束后公开的种子" }
      }
    },
    "Error": { "$ref": "errors.schema.json#/$defs/ErrorMessage" },
    "FriendUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["friends", "incoming", "outgoing", "recent"],
      "properties": {
        "friends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "status"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string", "description": "6 位玩家编号" },
              "displayName": { "type": "string" },
              "status": { "type": "string", "enum": ["online", "inGame", "offline"] }
            }
          }
        },
        "incoming": {
          "type": "array",
          "items": { "$ref": "#/$defs/FriendRequestItem" }
        },
        "outgoing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "sentAt"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string" },
              "displayName": { "type": "string" },
              "sentAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "recent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["playerId", "playerCode", "displayName", "relation"],
            "properties": {
              "playerId": { "type": "string" },
              "playerCode": { "type": "string" },
              "displayName": { "type": "string" },
              "relation": { "type": "string", "enum": ["none", "friend", "incoming", "outgoing"] }
            }
          }
        }
      }
    },
    "FriendRequestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerId", "playerCode", "displayName", "sentAt"],
      "properties": {
        "playerId": { "type": "string" },
        "playerCode": { "type": "string" },
        "displayName": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" }
      }
    },
    "FriendInvite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "fromPlayerId", "fromPlayerCode", "fromDisplayName", "roomCode", "expiresAt"],
      "properties": {
        "inviteId": { "type": "string" },
        "fromPlayerId": { "type": "string" },
        "fromPlayerCode": { "type": "string" },
        "fromDisplayName": { "type": "string" },
        "roomCode": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "FriendInviteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "accepted"],
      "properties": {
        "inviteId": { "type": "string" },
        "accepted": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "description": "拒绝或失败原因的错误码" }
      }
    },
    "InviteAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inviteId", "roomCode"],
      "properties": {
        "inviteId": { "type": "string" },
        "roomCode": { "type": "string" }
      }
    }
  }
}
