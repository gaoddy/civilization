{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civilization.local/protocol/v1/errors.schema.json",
  "title": "协议错误码 v1",
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "NOT_ENOUGH_GOLD",
        "SHOP_SLOT_EMPTY",
        "NO_SPACE",
        "INVALID_STAGE",
        "NO_SUCH_MINION",
        "ALREADY_MAX_ERA",
        "CARD_NOT_IN_HAND",
        "HERO_NOT_SELECTED",
        "HERO_POWER_LIMIT",
        "SEVEN_VOYAGES_ACTIVE",
        "NOT_ACTIVE_SKILL",
        "INVALID_CHOICE",
        "NO_VALID_TARGET",
        "TARGET_NOT_ALLOWED",
        "AUTH_FAILED",
        "TOKEN_EXPIRED",
        "AUTH_RATE_LIMITED",
        "SESSION_REPLACED",
        "BAD_PAYLOAD",
        "UNKNOWN_TYPE",
        "RATE_LIMITED",
        "NOT_IN_ROOM",
        "NOT_HOST",
        "ROOM_NOT_FOUND",
        "ROOM_FULL",
        "ROOM_NOT_READY",
        "SEQUENCE_STALE",
        "FRIEND_NOT_FOUND",
        "FRIEND_SELF",
        "FRIEND_ALREADY",
        "FRIEND_REQUEST_PENDING",
        "FRIEND_LIST_FULL",
        "FRIEND_REQUEST_FULL",
        "FRIEND_REQUEST_LIMIT",
        "NOT_FRIENDS",
        "FRIEND_OFFLINE",
        "FRIEND_BUSY",
        "INVITE_NOT_FOUND",
        "INVITE_EXPIRED",
        "STEAM_AUTH_FAILED",
        "STEAM_UNAVAILABLE",
        "STEAM_DISABLED",
        "PHONE_INVALID",
        "PHONE_ALREADY_BOUND",
        "PHONE_CODE_UNAVAILABLE",
        "CODE_INVALID",
        "CODE_EXPIRED",
        "ALREADY_IN_ROOM",
        "QUEUE_ALREADY",
        "QUEUE_IN_ROOM",
        "QUEUE_NOT_JOINED",
        "INTERNAL_ERROR"
      ],
      "description": "稳定错误码，只增不改"
    },
    "ErrorMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageId", "message", "retryable"],
      "properties": {
        "code": { "$ref": "errors.schema.json#/$defs/ErrorCode", "description": "错误码" },
        "messageId": { "type": "string", "description": "面向玩家的文本 id，默认 error.<CODE>" },
        "messageParams": { "type": "array", "items": { "type": "string" }, "description": "messageId 的 %s 参数" },
        "message": { "type": "string", "description": "面向日志的错误说明，不作为 UI 文案" },
        "clientIntentId": { "type": "string", "description": "被拒绝意图的 clientIntentId" },
        "retryable": { "type": "boolean", "description": "是否可原样重试" }
      }
    }
  }
}
